    <MODULE COREREVISION="29" FULLNAME="/gessm_cfg" HWVERSION="2.0" INSTANCE="gessm_cfg" IPTYPE="PERIPHERAL" IS_ENABLE="1" MODCLASS="PERIPHERAL" MODTYPE="axi_gpio" VLNV="xilinx.com:ip:axi_gpio:2.0">
